rules_version = '2';

// Firebase Storage Security Rules
// Designed for the On Deck Baseball Stadium App
// Allows public read access to media and authenticated write access for UAT/Production assets.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all assets (Logos, Audio, FX)
    match /{allPaths=**} {
      allow read: if true;
    }

    // UAT Workspace Assets
    // Explicitly allow writes for authenticated users to UAT directories
    match /logos_UAT/{imageId} {
      allow write: if request.auth != null;
    }
    
    match /audio_UAT/{audioId} {
      allow write: if request.auth != null;
    }

    match /announcement_audio_UAT/{audioId} {
      allow write: if request.auth != null;
    }

    match /sound_fx_UAT/{fxId} {
      allow write: if request.auth != null;
    }

    // Production Assets
    match /audio/{audioId} {
      allow write: if request.auth != null;
    }

    match /logos/{logoId} {
      allow write: if request.auth != null;
    }

    // Global Fallback
    // Ensure any authenticated user can write to assets during UAT testing
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}