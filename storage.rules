rules_version = '2';

// Firebase Storage Security Rules
// Designed for the On Deck Baseball Stadium App
// Allows public read access to media and authenticated write access for UAT/Production assets.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access to all assets (Logos, Audio, FX, Schedules)
    match /{allPaths=**} {
      allow read: if true;
    }

    // Authenticated Write Access for all App Folders
    // Covers: logos_UAT, audio_UAT, sound_fx_UAT, schedule-uploads, walkup-track-files, etc.
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}