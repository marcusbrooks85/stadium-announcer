rules_version = '2';

// Craft rules for Firebase Storage
// See https://firebase.google.com/docs/storage/security for more information

service firebase.storage {
  match /b/{bucket}/o {
    // UAT Workspace: Team Logos
    // Allows any authenticated user to upload logos in the UAT environment
    match /logos_UAT/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // UAT Workspace: Player Announcement Audio
    // Allows authenticated users to upload player voice clips
    match /audio_UAT/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // UAT Workspace: General Announcement Audio (Player Profiles)
    match /announcement_audio_UAT/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Production: Player Announcement Audio
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: Deny all other requests
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}