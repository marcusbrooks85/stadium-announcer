{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Represents a baseball player and their metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "number": { "type": "number" },
        "announcementAudioUrl": { "type": "string" },
        "songs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "videoId": { "type": "string" },
              "startAt": { "type": "number" }
            }
          }
        }
      },
      "required": ["name", "number"]
    },
    "StadiumSong": {
      "title": "Stadium Song",
      "description": "A generic song used for organ hits or crowd pump-ups.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "link": { "type": "string" },
        "startTime": { "type": "number" },
        "order": { "type": "number" }
      },
      "required": ["title", "link"]
    },
    "GameWin": {
      "title": "Game Win",
      "description": "Represents the status (won, cancelled, etc.) of a specific baseball game.",
      "type": "object",
      "properties": {
        "won": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "snackPlayerId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "autoSynced": { "type": "boolean" }
      },
      "required": ["updatedAt"]
    },
    "User": {
      "title": "User Profile",
      "description": "Metadata for authenticated users.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "teamId": { "type": "string" }
      }
    },
    "Team": {
      "title": "Team",
      "description": "A baseball team in the multi-tenant system.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/backend/entities/Player" },
      "description": "Collection of players in the team."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles and permissions."
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "#/backend/entities/Team" },
      "description": "League teams and their unique codes."
    }
  }
}
