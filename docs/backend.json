{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Represents a baseball player and their metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "number": { "type": "number" },
        "announcementAudioUrl": { "type": "string" },
        "songs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "videoId": { "type": "string" },
              "startAt": { "type": "number" }
            }
          }
        }
      },
      "required": ["name", "number"]
    },
    "StadiumSong": {
      "title": "Stadium Song",
      "description": "A generic song used for organ hits or crowd pump-ups.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "link": { "type": "string" },
        "startTime": { "type": "number" },
        "order": { "type": "number" }
      },
      "required": ["title", "link"]
    },
    "GameWin": {
      "title": "Game Win",
      "description": "Represents the status (won, cancelled, etc.) of a specific baseball game.",
      "type": "object",
      "properties": {
        "won": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "snackPlayerId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "autoSynced": { "type": "boolean" }
      },
      "required": ["updatedAt"]
    },
    "GameStats": {
      "title": "Game Stats",
      "description": "Stats for all players and team scores for a specific game.",
      "type": "object",
      "properties": {
        "homeScore": { "type": "number" },
        "awayScore": { "type": "number" },
        "statsSynced": { "type": "boolean" },
        "playerStats": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "ab": { "type": "number" },
              "h": { "type": "number" },
              "r": { "type": "number" },
              "rbi": { "type": "number" }
            }
          }
        }
      }
    },
    "TeamStanding": {
      "title": "Team Standing",
      "description": "Aggregated wins, losses and ties for the season.",
      "type": "object",
      "properties": {
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "ties": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": { "$ref": "#/backend/entities/Player" },
      "description": "Collection of players in the team."
    },
    "/organ_songs/{songId}": {
      "schema": { "$ref": "#/backend/entities/StadiumSong" },
      "description": "Collection of organ master hits."
    },
    "/pump_up_songs/{songId}": {
      "schema": { "$ref": "#/backend/entities/StadiumSong" },
      "description": "Collection of crowd pump-up hype songs."
    },
    "/game_wins/{gameId}": {
      "schema": { "$ref": "#/backend/entities/GameWin" },
      "description": "Collection storing outcomes for specific games."
    },
    "/game_stats/{gameId}": {
      "schema": { "$ref": "#/backend/entities/GameStats" },
      "description": "Collection storing per-game player stats and scores."
    },
    "/standings/{teamId}": {
      "schema": { "$ref": "#/backend/entities/TeamStanding" },
      "description": "Aggregated season standings."
    }
  }
}