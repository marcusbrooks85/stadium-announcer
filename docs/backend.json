
{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Represents a baseball player and their metadata.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "number": { "type": "number" },
        "announcementAudioUrl": { "type": "string" },
        "songs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "videoId": { "type": "string" },
              "startAt": { "type": "number" }
            }
          }
        }
      },
      "required": ["name", "number"]
    },
    "StadiumSong": {
      "title": "Stadium Song",
      "description": "A generic song used for organ hits or crowd pump-ups.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "link": { "type": "string" },
        "startTime": { "type": "number" },
        "order": { "type": "number" }
      },
      "required": ["title", "link"]
    },
    "User": {
      "title": "User Profile",
      "description": "Metadata for authenticated users including granular RBAC roles.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["association_admin", "super_admin", "league_admin", "booth_admin", "user"] },
        "teamId": { "type": "string" },
        "playerId": { "type": "string" }
      }
    },
    "Division": {
      "title": "Division",
      "description": "A league division grouping teams by age or skill level.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ageRange": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Team": {
      "title": "Team",
      "description": "A baseball team within a specific division.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "divisionId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "logoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "GlobalAnnouncement": {
      "title": "Global Announcement",
      "description": "Targeted notification sent by association admins.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "scope": { "type": "string", "enum": ["association", "division", "team"] },
        "targetId": { "type": "string" },
        "createdBy": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "scope"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users_UAT/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "User profiles and extended permissions for UAT."
    },
    "/divisions_UAT/{divisionId}": {
      "schema": { "$ref": "#/backend/entities/Division" },
      "description": "Collection of divisions (T-Ball, Majors, etc.) in UAT."
    },
    "/teams_UAT/{teamId}": {
      "schema": { "$ref": "#/backend/entities/Team" },
      "description": "League teams mapped to divisions in UAT."
    },
    "/global_announcements_UAT/{announcementId}": {
      "schema": { "$ref": "#/backend/entities/GlobalAnnouncement" },
      "description": "Targeted announcements across scopes in UAT."
    },
    "/players_UAT/{playerId}": {
      "schema": { "$ref": "#/backend/entities/Player" },
      "description": "Collection of players within specific teams in UAT."
    }
  }
}
